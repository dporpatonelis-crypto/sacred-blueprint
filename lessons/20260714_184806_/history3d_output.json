  "dialogs": [
    {
      "character_id": "socrates",
      "question": "Πώς παρουσιάζει το Ευαγγέλιο του Ιωάννη το Άγιο Πνεύμα;",
      "answer": "Ως Παράκλητο και Πνεύμα της Αληθείας, που μαρτυρεί για τον Χριστό και οδηγεί την Εκκλησία στην αλήθεια."
    },
    {
      "character_id": "socrates",
      "question": "Γιατί η φράση «Κύριον και Ζωοποιόν» είναι σημαντική;",
      "answer": "Επειδή ομολογεί το Πνεύμα ως πηγή ζωής και ως πρόσωπο που λατρεύεται μαζί με τον Πατέρα και τον Υιό."
    },
    {
      "character_id": "Constantine compressed (2).glb",
      "question": "Τι διακρίνει την ποιμαντική οικονομία από υποχώρηση στην πίστη;",
      "answer": "Η οικονομία αφορά τον σοφό τρόπο διδασκαλίας· δεν αφαιρεί την αλήθεια που η Εκκλησία ομολογεί."
    },
    {
      "character_id": "monk compressed.glb",
      "question": "Πού οδηγεί τελικά η Πνευματολογία;",
      "answer": "Στη μετοχή στη ζωή του Τριαδικού Θεού, όπως αυτή βιώνεται στη λατρεία και στην αγιότητα."
    }
  ],
  "facts": [
    {
      "character_id": "socrates",
      "fact": "Στο Ιω. 15:26 το Πνεύμα ονομάζεται Πνεύμα της Αληθείας και λέγεται ότι εκπορεύεται από τον Πατέρα."
    },
    {
      "character_id": "monk compressed.glb",
      "fact": "Ο Μέγας Βασίλειος υπερασπίστηκε τη δοξολογική τιμή του Αγίου Πνεύματος στο Περί του Αγίου Πνεύματος."
    },
    {
      "character_id": "Constantine compressed (2).glb",
      "fact": "Το Σύμβολο της Κωνσταντινουπόλεως του 381 ομολογεί το Πνεύμα ως «Κύριον και Ζωοποιόν»."
    },
    {
      "character_id": "hypatia",
      "fact": "Η φράση «συμπροσκυνούμενον και συνδοξαζόμενον» δηλώνει κοινή λατρευτική τιμή με τον Πατέρα και τον Υιό."
    },
    {
      "character_id": "aristotle",
      "fact": "Η δογματική γλώσσα των Πατέρων υπηρετεί τη μυσταγωγική και λειτουργική ζωή της Εκκλησίας."
    }
  ],
